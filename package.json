{
  "name": "biblioteca-juegos",
  "repository": "github:VinZoffoli/vinteca",
  "productName": "Biblioteca de juegos",
  "version": "1.3.0",
  "description": "Biblioteca combinada de Steam y Epic Games",
  "author": "Vincenzo",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "icon": "node scripts/make-icon.js",
    "presentmon": "node scripts/get-presentmon.js",
    "dist": "node scripts/get-presentmon.js && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "26.16.1"
  },
  "dependencies": {
    "js-yaml": "4.1.0",
    "koffi": "3.3.1"
  },
  "build": {
    "appId": "local.biblioteca-juegos",
    "productName": "Biblioteca de juegos",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**",
      "renderer/**",
      "build/icon.ico",
      "node_modules/koffi/**",
      "node_modules/@koromix/koffi-win32-x64/**",
      "node_modules/js-yaml/**",
      "node_modules/argparse/**"
    ],
    "extraResources": [
      { "from": "build/tools/PresentMon.exe", "to": "tools/PresentMon.exe" }
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Biblioteca de juegos",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Biblioteca-de-juegos-Setup-${version}.exe"
    }
  }
}
