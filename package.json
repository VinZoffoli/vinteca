{
  "name": "biblioteca-juegos",
  "repository": "github:VinZoffoli/vinteca",
  "productName": "ViperTeca",
  "version": "1.18.0",
  "description": "ViperTeca: tus juegos de Steam, Epic y otras tiendas en una sola biblioteca",
  "author": "Vincenzo",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "icon": "node scripts/make-icon.js",
    "presentmon": "node scripts/get-presentmon.js",
    "dist": "node scripts/get-presentmon.js && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "26.16.1"
  },
  "dependencies": {
    "js-yaml": "4.1.0",
    "koffi": "3.3.1",
    "monaco-editor": "0.52.2",
    "openrgb-sdk": "0.6.0",
    "qrcode-generator": "2.0.4"
  },
  "build": {
    "appId": "local.biblioteca-juegos",
    "productName": "ViperTeca",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**",
      "renderer/**",
      "build/icon.ico",
      "build/icon.png",
      "node_modules/koffi/**",
      "node_modules/@koromix/koffi-win32-x64/**",
      "node_modules/js-yaml/**",
      "node_modules/argparse/**",
      "node_modules/qrcode-generator/**",
      "node_modules/openrgb-sdk/**",
      "node_modules/bufferpack/**",
      "node_modules/monaco-editor/min/**",
      "node_modules/monaco-editor/package.json",
      "!node_modules/monaco-editor/{esm,dev,min-maps}/**"
    ],
    "extraResources": [
      {
        "from": "build/tools/PresentMon.exe",
        "to": "tools/PresentMon.exe"
      }
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ViperTeca",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "ViperTeca-Setup-${version}.exe"
    }
  }
}
